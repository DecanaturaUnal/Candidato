# Dependencias
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Compilación de Next.js
/.next/
/out/
/build

# Entorno virtual de Python y sus cachés
/scripts/venv/
__pycache__/
*.py[cod]

# Salida de los scripts: capturas, comparaciones, exportaciones y respaldos.
# Puede contener correos electrónicos: nunca debe subirse al repositorio.
/scripts/salida/

# Ayuda de desarrollo: copia del mockup para superponerla sobre la página
/public/_referencia/

# Variables de entorno. Se ignoran TODAS menos el ejemplo, que sí debe versionarse
# porque documenta qué hay que rellenar.
.env*
!.env.example

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Varios
.DS_Store
Thumbs.db
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/coverage
