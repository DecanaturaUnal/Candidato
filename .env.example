# =============================================================================
# PLANTILLA de variables de entorno. NO PONGA CLAVES REALES EN ESTE ARCHIVO.
#
# Este archivo SÍ se sube al repositorio: existe para documentar qué hay que
# rellenar. Las claves reales van en `.env.local`, que está en .gitignore.
#
#   copy .env.example .env.local
#
# Regla: solo las variables con prefijo NEXT_PUBLIC_ llegan al navegador. Las
# demas viven unicamente en el servidor. Si una clave secreta acaba con prefijo
# NEXT_PUBLIC_, queda publicada en el codigo del cliente.
# =============================================================================

# --- Supabase: publico (viaja al navegador, protegido por RLS) ---------------
# Panel de Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="pegue-aqui-la-anon-key"

# --- Supabase: secreto (SOLO servidor) ---------------------------------------
# Se salta la RLS por completo. Nunca debe importarse desde un componente de
# cliente ni exponerse en el navegador.
SUPABASE_SERVICE_ROLE_KEY="pegue-aqui-la-service-role-key"

# --- Conexion directa a Postgres (solo para aplicar migraciones) --------------
# NO es la URL de arriba: es la cadena de conexion a la base. Se copia de
# Project Settings > Database > Connection string > URI, y hay que reemplazar
# [YOUR-PASSWORD] por la contrasena que eligio al crear el proyecto.
#
# OJO: si la contrasena tiene caracteres como @ : / ? # o espacios, hay que
# codificarlos (@ se escribe %40, : se escribe %3A). Y los corchetes [ ] del
# marcador NO van en la cadena final.
#
# La usa `npm run esquema`. La aplicacion nunca la lee.
DATABASE_URL="postgresql://postgres:CONTRASENA@db.xxxxxxxxxxxxxxxx.supabase.co:5432/postgres"

# --- Cloudflare Turnstile (captcha invisible) --------------------------------
# https://dash.cloudflare.com > Turnstile
#
# Para pasar `npm run verificar:flujo` se usan las claves de PRUEBA, que siempre
# aprueban. Cambielas por las reales antes de desplegar:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY="pegue-aqui-la-site-key"
TURNSTILE_SECRET_KEY="pegue-aqui-la-secret-key"

# --- Sal para el hash de IP --------------------------------------------------
# La IP de quien envia un mensaje se guarda como SHA-256(ip + esta sal), nunca en
# claro. Debe ser una cadena larga y aleatoria; se genera con:
#   npm run sal
# Si cambia esta sal, los hashes anteriores dejan de poder compararse.
IP_HASH_SALT="cadena-larga-y-aleatoria-cambieme"

# --- URL publica del sitio ---------------------------------------------------
# La usa el enlace magico de acceso al panel para saber a donde volver.
# En local: http://localhost:3000   En produccion: https://su-dominio.co
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Porton de acceso (opcional) ---------------------------------------------
# Mientras el sitio no sea publico, cierra TODO detras de una clave compartida.
# Es una barrera de cortesia para revisar en el dominio real sin que quede a la
# vista, no un sistema de autenticacion: quien modera sigue entrando por enlace
# magico y la base la sigue protegiendo la RLS.
# Dejela VACIA o quite la linea para abrir el sitio al publico; despues, redespliegue.
CLAVE_PORTON=""
